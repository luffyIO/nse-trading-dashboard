{
  "name": "trading-bot",
  "version": "1.0.2",
  "description": "NSE market dashboard with paper-only strategy research",
  "productName": "NSE Trading Dashboard",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test",
    "build:pages": "node build-pages.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "keywords": [],
  "author": "luffyIO <116873883+luffyIO@users.noreply.github.com>",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.0"
  },
  "build": {
    "appId": "com.luffyio.nsetradingdashboard",
    "productName": "NSE Trading Dashboard",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "styles.css",
      "script.js",
      "strategy-engine.js",
      "server.js",
      "config.js",
      "!test{,/**/*}",
      "!.github{,/**/*}",
      "!.env"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "category": "public.app-category.finance",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Finance",
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}"
    }
  }
}
